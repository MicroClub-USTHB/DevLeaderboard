# Copy to /opt/leaderboard/.env on the server (chmod 600). Never commit the real file.
# Classic PAT with repo + read:org (full member list, private repos).
# Preferred: a GitHub App installed on the org (own quota, no person's account). Read-only
# permissions: Contents, Issues, Pull requests, Metadata and Members. Put the downloaded
# private key at /opt/leaderboard/github-app.pem (chmod 600) and point GITHUB_APP_KEY_FILE at it.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_KEY_FILE=/opt/leaderboard/github-app.pem
# Used when the app is not set or is unavailable. Optional once the app works.
GITHUB_TOKEN=
# Second token from ANOTHER GitHub account, used while the first is rate limited (optional).
GITHUB_TOKEN_FALLBACK=
LEADERBOARD_ORGS=MicroClub-USTHB
# Dev department filter (optional; leave MCID_URL empty to turn it off)
MCID_URL=
MCID_API_KEY=
MCID_DEV_ROLE_IDS=

# "Link your GitHub" on the Dev tab: members sign in with MCID and submit their GitHub
# username to an MCID inbound webhook (identityMapping: provider github,
# memberIdField profile.discordId, handleField profile.github). Leave MCID_PROJECT_ID
# empty to turn it off. MCID_URL and MCID_API_KEY above are reused (same MCID project).
# The redirect URI registered on that MCID project must be exactly:
#   <PUBLIC_URL>/api/auth/callback
MCID_PROJECT_ID=
MCID_SERVER_ID=
MCID_WEBHOOK_ID=
# only when the webhook requires a signature (the default)
MCID_WEBHOOK_SECRET=
PUBLIC_URL=https://leaderboard.164-68-103-224.sslip.io
# openssl rand -hex 32
SESSION_SECRET=change-me

# Daily Discord report: today's top 10 + this month's top 5. Empty webhook = off.
DISCORD_WEBHOOK_URL=
# midnight Algeria time, whatever the server's timezone
DISCORD_CRON=0 0 * * *
DISCORD_TIMEZONE=Africa/Algiers
DISCORD_SITE_URL=https://leaderboard.164-68-103-224.sslip.io
DISCORD_USERNAME=Micro Club Leaderboard
# empty = <DISCORD_SITE_URL>/favicon.png
DISCORD_AVATAR_URL=
DISCORD_TODAY_LIMIT=10
DISCORD_MONTH_LIMIT=5
